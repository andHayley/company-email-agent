# Company Email Agent: copy to .env and fill in locally. Never commit .env.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# To use DeepSeek, change LLM_PROVIDER to deepseek and set this key.
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional role overrides. Leave unset to use the provider defaults.
# DeepSeek defaults all three roles to deepseek-flash. Remove or update any
# OpenRouter-specific role overrides when switching to DeepSeek.
# CS329Z_GRADING_MODEL=deepseek-flash  # Agent, auxiliary calls and most live tests
# CS329Z_USER_MODEL=deepseek-flash     # simulated user
# CS329Z_JUDGE_MODEL=deepseek-flash    # simulation judge

# CS329Z_REASONING_EFFORT=low # OpenRouter only
# CS329Z_BUDGET_USD=25       # stop new calls once the local ledger reaches this
# CS329Z_EVAL_SLICE=5        # run live tests on the first N items only
